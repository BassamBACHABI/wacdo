# Remplacer par l'adresse de la base disponible depuis le conteneur.
# Pour le MySQL local lancé par Docker Desktop : host.docker.internal
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/wacdo_db
SPRING_DATASOURCE_USERNAME=wacdo
SPRING_DATASOURCE_PASSWORD=change-me
